# GATE AI Tutor Environment Configuration
# Copy this file to .env (optional) or export variables in your shell.

# LLM Provider ("ollama" or "openai_compatible")
GATE_LLM_PROVIDER=ollama

# Primary intended model identifier in Ollama (DO NOT use Llama as default)
GATE_LLM_MODEL=ministral-3:3b

# Ollama server base URL
OLLAMA_BASE_URL=http://localhost:11434

# Optional OpenAI-compatible endpoint (for vLLM / LM Studio / future fine-tuned server)
GATE_OPENAI_BASE_URL=http://localhost:8000/v1
GATE_OPENAI_API_KEY=

# Embedding model for Sentence Transformers
GATE_EMBEDDING_MODEL=all-MiniLM-L6-v2
